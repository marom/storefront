# Base URL of the Spring Boot ecommerce-api (no trailing slash). The client appends /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:8080
# ISO 4217 currency code used by Intl.NumberFormat for all money display.
NEXT_PUBLIC_CURRENCY=USD
# BCP 47 locale used by Intl.NumberFormat / Intl.DateTimeFormat.
NEXT_PUBLIC_LOCALE=en-US
